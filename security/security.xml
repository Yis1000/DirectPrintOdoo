<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.module.category" id="module_category_direct_print">
            <field name="name">Direct Print</field>
            <field name="description">Manage direct printing to local/network printers.</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_direct_print_manager" model="res.groups">
            <field name="name">Direct Print Manager</field>
            <field name="category_id" ref="module_category_direct_print"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
