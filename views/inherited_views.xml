<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sale Order -->
    <record id="view_order_form_inherit_direct_print" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.direct.print</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_direct_print" string="Impresión Directa" type="object" icon="fa-print"/>
            </xpath>
        </field>
    </record>

    <!-- Account Move (Invoice) -->
    <record id="view_move_form_inherit_direct_print" model="ir.ui.view">
        <field name="name">account.move.form.inherit.direct.print</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_direct_print" string="Impresión Directa" type="object" icon="fa-print"/>
            </xpath>
        </field>
    </record>

    <!-- Stock Picking -->
    <record id="view_picking_form_inherit_direct_print" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.direct.print</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_direct_print" string="Impresión Directa" type="object" icon="fa-print"/>
            </xpath>
        </field>
    </record>

    <!-- MRP Production -->
    <record id="mrp_production_form_view_inherit_direct_print" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.direct.print</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_direct_print" string="Impresión Directa" type="object" icon="fa-print"/>
            </xpath>
        </field>
    </record>

    <!-- Purchase Order -->
    <record id="purchase_order_form_inherit_direct_print" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.direct.print</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_direct_print" string="Impresión Directa" type="object" icon="fa-print"/>
            </xpath>
        </field>
    </record>

    <!-- Res Partner -->
    <record id="view_partner_form_inherit_direct_print" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.direct.print</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Agregar un header si no existe, o ponerlo en la caja de botones -->
            <!-- Odoo Partners usually don't have header. We'll add one before sheet -->
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_direct_print" string="Impresión Directa" type="object" icon="fa-print"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
