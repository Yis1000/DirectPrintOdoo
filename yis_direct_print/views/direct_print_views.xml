<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vistas de Impresora -->
    <record id="view_direct_print_printer_form" model="ir.ui.view">
        <field name="name">direct.print.printer.form</field>
        <field name="model">direct.print.printer</field>
        <field name="arch" type="xml">
            <form string="Impresora">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="printer_identifier"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="connection_type"/>
                            <field name="ip_address" invisible="connection_type != 'network'"/>
                            <field name="port" invisible="connection_type != 'network'" options="{'format': 0}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_direct_print_printer_tree" model="ir.ui.view">
        <field name="name">direct.print.printer.list</field>
        <field name="model">direct.print.printer</field>
        <field name="arch" type="xml">
            <list string="Impresoras">
                <field name="name"/>
                <field name="printer_identifier"/>
                <field name="connection_type"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Vistas de Configuración -->
    <record id="view_direct_print_config_form" model="ir.ui.view">
        <field name="name">direct.print.config.form</field>
        <field name="model">direct.print.config</field>
        <field name="arch" type="xml">
            <form string="Configuración de Impresión">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="print_area"/>
                            <field name="printer_id"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="auto_print"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_direct_print_config_tree" model="ir.ui.view">
        <field name="name">direct.print.config.list</field>
        <field name="model">direct.print.config</field>
        <field name="arch" type="xml">
            <list string="Configuraciones">
                <field name="name"/>
                <field name="print_area"/>
                <field name="printer_id"/>
                <field name="user_id"/>
                <field name="auto_print"/>
            </list>
        </field>
    </record>

    <!-- Vistas de Log -->
    <record id="view_direct_print_log_tree" model="ir.ui.view">
        <field name="name">direct.print.log.list</field>
        <field name="model">direct.print.log</field>
        <field name="arch" type="xml">
            <list string="Logs de Impresión" create="false" edit="false">
                <field name="printed_at"/>
                <field name="document_model"/>
                <field name="document_id"/>
                <field name="printer_id"/>
                <field name="user_id"/>
                <field name="status"/>
                <field name="error_message"/>
            </list>
        </field>
    </record>

    <!-- Acciones -->
    <record id="action_direct_print_printer" model="ir.actions.act_window">
        <field name="name">Impresoras</field>
        <field name="res_model">direct.print.printer</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_direct_print_config" model="ir.actions.act_window">
        <field name="name">Configuraciones de Impresión</field>
        <field name="res_model">direct.print.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_direct_print_log" model="ir.actions.act_window">
        <field name="name">Logs de Impresión</field>
        <field name="res_model">direct.print.log</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Menús -->
    <!-- Menú Raíz bajo Configuración/Ajustes (base.menu_administration) -->
    <menuitem id="menu_direct_print_root" 
              name="Impresión Directa" 
              parent="base.menu_administration" 
              sequence="100"
              groups="group_direct_print_manager"/>

    <menuitem id="menu_direct_print_printer" 
              name="Impresoras" 
              parent="menu_direct_print_root" 
              action="action_direct_print_printer" 
              sequence="10"/>

    <menuitem id="menu_direct_print_config" 
              name="Configuraciones" 
              parent="menu_direct_print_root" 
              action="action_direct_print_config" 
              sequence="20"/>

    <menuitem id="menu_direct_print_log" 
              name="Logs" 
              parent="menu_direct_print_root" 
              action="action_direct_print_log" 
              sequence="30"/>
</odoo>
